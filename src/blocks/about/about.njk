{% macro aboutBlock(props = {}) %}
{% set title = props.title or "О системе" %}
{% set topTexts = props.topTexts or [
"Онлайн платформа DDR-PRO позволяет вести и консолидировать все отчеты по бурению, заканчиванию и капитальному ремонту
скважин в облачной базе данных.",
"С целью повысить эффективность управления производственными процессами DDR-PRO автоматически формирует дэшборды,
содержащие краткий и информативный обзор операций по бурению и КРС на месторождении. А также является KPI инструментом
для анализа и принятия эффективных решений.",
"DDR-PRO служит облачным центром для документов, отчетов и различных данных полученных в ходе строительства или ремонта
скважины."
] %}
{% set topImageSrc = props.topImageSrc or "images/about-img.png" %}
{% set topImageAlt = props.topImageAlt or "img" %}
{% set reverseTop = props.reverseTop or false %}
{% set showBody = props.showBody if props.showBody is defined else true %}
{% set showTopDecor = props.showTopDecor if props.showTopDecor is defined else true %}
{% set contentLayout = props.contentLayout or "none" %}
{% set contentImageSrc = props.contentImageSrc or "images/about-img-long.jpg" %}
{% set contentImageAlt = props.contentImageAlt or "img" %}
{% set contentLeftTexts = props.contentLeftTexts or [] %}
{% set contentRightTexts = props.contentRightTexts or [] %}

<section class="about">
  <div class="container">
    <div class="about__inner">
      {% if showTopDecor %}
      <div class="about__decor-line decor-line decor-line--top"></div>
      {% endif %}
      {% if showBody %}
      <div class="about__body">
        {% if reverseTop %}
        <div class="about__titling titling">
          <h2 class="titling__title" data-aos="fade-right">
            {{ title }}
          </h2>
          <picture class="about__img about__img--mobile" data-aos="zoom-in">
            <img src="{{ topImageSrc }}" alt="{{ topImageAlt }}">
          </picture>
          <div class="titling__wrapper">
            {% for text in topTexts %}
            <p class="titling__text" data-aos="fade-right">
              {{ text }}
            </p>
            {% endfor %}
          </div>
        </div>
        <picture class="about__img about__img--desktop" data-aos="zoom-in">
          <img src="{{ topImageSrc }}" alt="{{ topImageAlt }}">
        </picture>
        {% else %}
        <picture class="about__img about__img--desktop" data-aos="zoom-in">
          <img src="{{ topImageSrc }}" alt="{{ topImageAlt }}">
        </picture>
        <div class="about__titling titling">
          <h2 class="titling__title" data-aos="fade-right">
            {{ title }}
          </h2>
          <picture class="about__img about__img--mobile" data-aos="zoom-in">
            <img src="{{ topImageSrc }}" alt="{{ topImageAlt }}">
          </picture>
          <div class="titling__wrapper">
            {% for text in topTexts %}
            <p class="titling__text" data-aos="fade-right">
              {{ text }}
            </p>
            {% endfor %}
          </div>
        </div>
        {% endif %}
      </div>
      {% endif %}

      {% if contentLayout == "image-text" %}
      <div class="about__content">
        <picture class="about__img about__img--long" data-aos="zoom-in">
          <img src="{{ contentImageSrc }}" alt="{{ contentImageAlt }}">
        </picture>
        <div class="about__context">
          {% for text in contentRightTexts %}
          <p class="about__text" data-aos="fade-right">
            {{ text }}
          </p>
          {% endfor %}
        </div>
      </div>
      {% endif %}

      {% if contentLayout == "text-image-text" %}
      <div class="about__content">
        <div class="about__context">
          {% for text in contentLeftTexts %}
          <p class="about__text" data-aos="fade-right">
            {{ text }}
          </p>
          {% endfor %}
        </div>
        <picture class="about__img about__img--long" data-aos="zoom-in">
          <img src="{{ contentImageSrc }}" alt="{{ contentImageAlt }}">
        </picture>
        <div class="about__context">
          {% for text in contentRightTexts %}
          <p class="about__text" data-aos="fade-right">
            {{ text }}
          </p>
          {% endfor %}
        </div>
      </div>
      {% endif %}
    </div>
  </div>
</section>
{% endmacro %}